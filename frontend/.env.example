# =============================================================================
# frontend/.env.example
# URL Tracer — Frontend Environment Variables
#
# INSTRUCTIONS:
#   1. Copy this file to .env.local (never commit .env.local to git)
#   2. Fill in your actual values
#   3. .env.local is listed in .gitignore — it will NOT be committed
#
# VITE NAMING CONVENTION:
#   Variables MUST be prefixed with VITE_ to be accessible in the browser bundle.
#
# SECURITY RULES:
#   ⚠ Only values that are SAFE TO EXPOSE PUBLICLY may go here.
#   ⚠ Never add SERVICE_ROLE_KEY, JWT_SECRET, DATABASE_PASSWORD, or any
#     privileged credential to frontend environment variables.
#   The Supabase anon key is safe to expose — it is designed for client-side use
#   and is subject to Row Level Security (RLS) policies.
# =============================================================================

# ─── Backend API ──────────────────────────────────────────────────────────────
# URL of the FastAPI backend
# Development: http://localhost:8000
# Production:  https://api.url-tracer.yourdomain.com
VITE_API_URL=http://localhost:8000

# ─── Supabase (public / client-side) ─────────────────────────────────────────
# Your Supabase project URL — safe to expose publicly
VITE_SUPABASE_URL=

# Supabase anon key — safe to expose publicly (enforced by RLS)
VITE_SUPABASE_ANON_KEY=

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to false to disable mock data and use the real backend
# Must be false in all non-development environments
VITE_USE_MOCK=false

# ─── Application ──────────────────────────────────────────────────────────────
# Environment name shown in the UI (optional)
VITE_APP_ENV=development
