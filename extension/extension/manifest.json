{
  "manifest_version": 3,
  "name": "URL Tracer — Phishing Shield",
  "short_name": "URL Tracer",
  "description": "Real-time phishing and malicious URL detection powered by the URL Tracer ML engine.",
  "version": "1.0.0",

  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],

  "web_accessible_resources": [
    {
      "resources": ["warning/warning.html", "warning/warning.css", "warning/warning.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Check this site — URL Tracer",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
