# =============================================================================
# URL Tracer — Production .gitignore
# Phase 0: Architecture Freeze
# =============================================================================

# ─── Environment / Secrets ────────────────────────────────────────────────────
# Never commit real credentials, API keys, or private keys.
.env
.env.*
!.env.example

# ─── Private keys / certificates ─────────────────────────────────────────────
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# ─── Service account / credentials files ─────────────────────────────────────
credentials.json
service-account.json
google-services.json
GoogleService-Info.plist
serviceAccountKey.json

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/.vite/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.eggs/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env_python/

# ─── Databases / local data ───────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── PCAP files (may contain real network data) ───────────────────────────────
*.pcap
*.pcapng
*.cap

# ─── ML model artifacts (large binary files) ─────────────────────────────────
*.pkl
*.pickle
*.joblib
*.h5
*.pt
*.pth
ML/ml_data/*.csv
ML/ml_data/*.json
ML/ml_data/data/
ML/ml_data/models/

# ─── Uploaded / temporary files ───────────────────────────────────────────────
backend/uploads/
backend/tmp/
uploads/
tmp/
*.tmp
*.temp

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Build outputs ────────────────────────────────────────────────────────────
build/
dist/
*.egg

# ─── Sample / test data ───────────────────────────────────────────────────────
# Remove this line if you intentionally want to keep test uploads in git
backend/sample_data/
