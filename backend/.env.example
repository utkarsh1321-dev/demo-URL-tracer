# =============================================================================
# backend/.env.example
# URL Tracer — Backend Environment Variables
#
# INSTRUCTIONS:
#   1. Copy this file to .env (never commit .env to git)
#   2. Fill in your actual values
#   3. .env is listed in .gitignore — it will NOT be committed
#
# SECURITY RULES:
#   - Never commit real values to this file
#   - Never hardcode secrets in Python source code
#   - Keep this file in sync whenever new variables are added
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (Phase 2+)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase anon/public key — safe for read operations subject to RLS
SUPABASE_ANON_KEY=

# Supabase service-role key — NEVER expose this to the frontend or extension
# Used only by the backend for admin operations
SUPABASE_SERVICE_ROLE_KEY=

# ─── Authentication / JWT ─────────────────────────────────────────────────────
# Supabase JWT secret — used to verify user tokens in the backend
# Found in: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ─── ML Model ─────────────────────────────────────────────────────────────────
# Absolute path to the trained Random Forest model artifact
# Example (local dev): ./ML/ml_data/models/rf_model.pkl
# Example (production): /app/models/rf_model.pkl
MODEL_PATH=

# ─── Application ──────────────────────────────────────────────────────────────
# Environment: development | staging | production
APP_ENV=development

# Secret key for any internal signing (not Supabase JWT)
APP_SECRET_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Development example: http://localhost:5173
# Production example:  https://url-tracer.yourdomain.com
ALLOWED_ORIGINS=https://demo-url-tracer.vercel.app/


# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per minute for the URL analysis endpoint
RATE_LIMIT_URL_ANALYSIS=20

# Requests per minute for PCAP upload
RATE_LIMIT_PCAP_UPLOAD=5

# ─── File Upload ──────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default: 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800
